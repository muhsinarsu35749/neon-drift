# Copy to .env in the repo root, or pass the same names to `docker run --env-file`.
# Never commit the real password.
PORT=8787
BROKER_URL=https://edp-broker.codewithpeter.com
BROKER_USER=team3
BROKER_PASSWORD=
BROKER_TOPIC=team3.events
BROKER_GROUP=team3.leaderboard
# Public game: https://team3-game.codewithpeter.com
# Wheel bridge on a laptop: GAME_SERVER_URL=wss://team3-game.codewithpeter.com
# Optional. Defaults to data/leaderboard.sqlite when running from source,
# and /tmp/neon-drift/leaderboard.sqlite in the Docker image.
# LEADERBOARD_PATH=
